{
    "name": "anun333/oe-module-behavioral-health",
    "description": "42 CFR Part 2 consents and disclosures for OpenEMR: each disclosure tied to its consent in OpenEMR's own Disclosures record, with the 2.32 notice and the accounting of disclosures.",
    "type": "openemr-module",
    "license": "GPL-3.0-or-later",
    "keywords": ["openemr", "openemr-module", "42-cfr-part-2", "behavioral-health", "substance-use-disorder"],
    "homepage": "https://github.com/anun333/oe-module-behavioral-health",
    "require": {
        "php": ">=8.2",
        "anun333/openhealthcare-common": "^1.0",
        "openemr/oe-module-installer-plugin": "^0.1.5"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "OpenHealthcare\\BehavioralHealth\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "OpenHealthcare\\BehavioralHealth\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "openemr/oe-module-installer-plugin": true
        },
        "sort-packages": true
    }
}
